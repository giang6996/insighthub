# Copy to security/.env.day6.gateway.local and replace placeholders locally.
# Never commit the local copy or workload virtual keys.
LITELLM_DB_USER=litellm
LITELLM_DB_NAME=litellm
LITELLM_DB_PASSWORD=replace-with-local-random-password
LITELLM_MASTER_KEY=sk-replace-with-local-master-key
LITELLM_SALT_KEY=sk-replace-with-local-salt-key
LITELLM_PORT=14000
